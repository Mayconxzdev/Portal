# ARQUIVO DE EXEMPLO — SOMENTE DESENVOLVIMENTO LOCAL
# Copie para `.env`, troque todos os valores `local-dev-*` e nunca versione o arquivo resultante.
# Produção exige segredos gerados por um gerenciador de credenciais e configuração segura de cookies/CORS.

# ==============================================================================
# CONFIGURAÇÕES GERAIS DO PORTAL (DESENVOLVIMENTO LOCAL)
# ==============================================================================

# Nome e ambiente do projeto
PROJECT_NAME="Portal"
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1

# Chave secreta para JWT e sessões locais (use uma string segura em produção)
JWT_SECRET=local-dev-only-change-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY=default-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Cofre de credenciais do modulo TI.
# Em producao, use uma chave Fernet real gerada com seguranca e nunca versionada.
# Em desenvolvimento, se vazio, o backend deriva uma chave local a partir do JWT_SECRET.
IT_CREDENTIAL_VAULT_KEY=

# ==============================================================================
# USUÁRIO DE DEMONSTRAÇÃO LOCAL
# ==============================================================================
# Usado somente pelo script scripts/seed_dev.py. Troque antes de compartilhar o ambiente.
PORTAL_DEV_ADMIN_USER=vesper_admin
PORTAL_DEV_ADMIN_PASSWORD=portal-dev-only
PORTAL_DEV_ADMIN_EMAIL=admin@vesper.local
PORTAL_DEV_AUDITOR_PASSWORD=portal-dev-only

# ==============================================================================
# BANCO DE DADOS (POSTGRESQL)
# ==============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=55432
POSTGRES_DB=portal_vesper
POSTGRES_USER=vesper_admin
POSTGRES_PASSWORD=local-dev-postgres-password

# URL de Conexão com o Banco de Dados (usada pelo backend local)
# Para conexão assíncrona: postgresql+asyncpg://user:pass@host:port/db
# Para conexão síncrona: postgresql://user:pass@host:port/db
DATABASE_URL=postgresql://vesper_admin:local-dev-postgres-password@localhost:55432/portal_vesper

# ==============================================================================
# EVENTOS E CACHE (REDIS)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=local-dev-redis-password

# ==============================================================================
# STORAGE COMPATÍVEL COM S3 (MINIO)
# ==============================================================================
MINIO_ROOT_USER=vesper_minio_user
MINIO_ROOT_PASSWORD=local-dev-minio-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=knowledge-base

# ==============================================================================
# MOTOR DE AUTOMACÃO (N8N)
# ==============================================================================
N8N_PORT=5680
N8N_ENCRYPTION_KEY=local-dev-n8n-encryption-key
N8N_USERMANAGEMENT_JWT_SECRET=local-dev-n8n-jwt-secret

# ==============================================================================
# COMPRAS INTELIGENTES
# ==============================================================================
# Chaves devem ficar no Cofre/ambiente local. Nunca commitar valores reais.
SERPAPI_API_KEY=
GEMINI_API_KEY=
PURCHASES_GEMINI_MODEL=gemini-3.5-flash
PURCHASES_SEARXNG_URL=http://localhost:8088
PURCHASES_SEARCH_MAX_PROVIDER_CALLS=12
PURCHASES_SEARCH_CACHE_TTL_SECONDS=3600
PURCHASES_PLAYWRIGHT_VERIFY_ENABLED=false
PURCHASES_TEST_EMAIL_RECIPIENT=

# Desenvolvimento local roda a pesquisa inline para evitar tela parada quando o worker nao esta aberto.
# Em servidor/compose, ligue true junto com o servico purchases-worker.
PURCHASES_RESEARCH_ASYNC_ENABLED=false
PURCHASES_RESEARCH_QUEUE_NAME=purchases_research

# ==============================================================================
# FRONTEND CONFIGS (VITE)
# ==============================================================================
VITE_API_URL=http://localhost:8000
# ==============================================================================
# IMAGENS DOCKER RECOMENDADAS (DESENVOLVIMENTO LOCAL MODERNO)
# ==============================================================================
POSTGRES_IMAGE=postgres:18.4-alpine
REDIS_IMAGE=redis:8.8-alpine
PYTHON_WORKER_IMAGE=python:3.14-slim
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.27.3
MINIO_IMAGE=quay.io/minio/minio:latest
SEARXNG_IMAGE=searxng/searxng:latest
ADMINER_IMAGE=adminer:latest
# Caminhos opcionais para importadores legados (não versionar dados reais).
PORTAL_COMPRAS_NOVA_XLSX=
PORTAL_CYBERSUL_XLSX=
PORTAL_UNIFIED_CATALOG_XLSX=

PURCHASES_XLSX_PATH=storage/imports/compras-demo.xlsx
PURCHASES_EXPORT_DIR=
PORTAL_EXPORT_DIR=
